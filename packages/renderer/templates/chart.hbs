<div class="df-slide flex h-full w-full flex-col gap-[var(--df-gap)] p-[var(--df-pad)] text-df-text font-body">
<h2 data-region="title" data-motion-el class="m-0 font-display text-df-text [text-transform:var(--df-title-transform)] leading-[var(--df-display-lh)] tracking-[calc(var(--df-display-tracking)+var(--df-title-tracking))] [overflow-wrap:anywhere] text-[length:calc(2.5rem*var(--df-scale))]">{{{regions.title}}}</h2>
<div data-region="body" class="flex min-h-0 flex-1 items-center justify-center [&_figure]:m-0 [&_figure]:h-full [&_figure]:w-full [&_svg]:h-full [&_svg]:max-h-full [&_svg]:w-full [&_svg]:max-w-full [overflow-wrap:anywhere] min-w-0">{{{regions.body}}}</div>
<p data-region="footer" class="m-0 text-[length:calc(1.125rem*var(--df-scale))] text-df-text-muted [overflow-wrap:anywhere] min-w-0 empty:hidden">{{{regions.footer}}}</p>
</div>
