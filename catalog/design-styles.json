{
  "$schema": "./_schema/design-styles.schema.json",
  "version": "1.0.0",
  "notes": "The 30 user-facing styles are grouped into 8 implementable families. The UI shows families; the member names are shown as 'Includes:' text for discoverability. Tokens are CSS-ready. IDs referenced from palettes.json, type-families.json, motion-templates.json and compat-matrix.json.",
  "families": [
    {
      "id": "minimal",
      "name": "Minimal",
      "tagline": "Less, but clearer.",
      "members": ["Minimalism", "Geominimalism", "Flat Design", "Bento Box"],
      "tokens": {
        "radius": "0.5rem",
        "borderWidth": "1px",
        "shadow": "none",
        "texture": "none",
        "gradients": false,
        "imageTreatment": "clean",
        "density": "low",
        "titleCase": "sentence",
        "maxWordsPerSlide": 35
      },
      "defaultPalette": "warm-minimalist",
      "allowedPalettes": ["warm-minimalist", "technical-slate", "nordic-mist", "pacific-forest"],
      "defaultType": "geometric-modern",
      "allowedTypes": ["geometric-modern", "swiss-neutral", "humanist"],
      "defaultMotion": "calm",
      "threeJs": "never",
      "layoutHints": ["bento grid for stat slides", "single column, left aligned", "generous margins ≥ 8% viewport"]
    },
    {
      "id": "swiss",
      "name": "Swiss / Bauhaus",
      "tagline": "Grid, type, primary colour.",
      "members": ["Swiss Style (International Typographic Style)", "Bauhaus", "Constructivism", "Mid-Century Modern", "Heroic Realism"],
      "tokens": {
        "radius": "0",
        "borderWidth": "0",
        "shadow": "none",
        "texture": "none",
        "gradients": false,
        "imageTreatment": "duotone",
        "density": "medium",
        "titleCase": "upper",
        "maxWordsPerSlide": 40
      },
      "defaultPalette": "bauhaus-primary",
      "allowedPalettes": ["bauhaus-primary", "technical-slate", "warm-minimalist", "desert-trail"],
      "defaultType": "swiss-neutral",
      "allowedTypes": ["swiss-neutral", "geometric-modern", "poster-grotesk"],
      "defaultMotion": "kinetic",
      "threeJs": "never",
      "layoutHints": ["12-col modular grid", "asymmetric placement", "oversized numerals for stat slides", "diagonal rules allowed"]
    },
    {
      "id": "brutalist",
      "name": "Brutalist",
      "tagline": "Raw, loud, unapologetic.",
      "members": ["Neo-Brutalism", "Grunge", "Punk"],
      "tokens": {
        "radius": "0",
        "borderWidth": "3px",
        "shadow": "6px 6px 0 var(--df-text)",
        "texture": "grain",
        "gradients": false,
        "imageTreatment": "high-contrast",
        "density": "medium",
        "titleCase": "upper",
        "maxWordsPerSlide": 30
      },
      "defaultPalette": "brutal-pop",
      "allowedPalettes": ["brutal-pop", "technical-slate", "tokyo-grid"],
      "defaultType": "brutalist-mono",
      "allowedTypes": ["brutalist-mono", "poster-grotesk"],
      "defaultMotion": "kinetic",
      "threeJs": "never",
      "layoutHints": ["thick black outlines on every block", "hard offset shadows", "visible grid lines optional", "no rounded corners anywhere"]
    },
    {
      "id": "glass-soft",
      "name": "Glass & Soft",
      "tagline": "Translucent layers, soft depth.",
      "members": ["Glassmorphism", "Neumorphism", "3D Design"],
      "tokens": {
        "radius": "1.25rem",
        "borderWidth": "1px",
        "shadow": "0 8px 32px rgba(0,0,0,0.12)",
        "texture": "none",
        "gradients": true,
        "backdropBlur": "16px",
        "surfaceAlpha": 0.55,
        "imageTreatment": "soft",
        "density": "medium",
        "titleCase": "sentence",
        "maxWordsPerSlide": 40
      },
      "defaultPalette": "nordic-mist",
      "allowedPalettes": ["nordic-mist", "technical-slate", "midnight-gala", "synthwave-sunset"],
      "defaultType": "geometric-modern",
      "allowedTypes": ["geometric-modern", "humanist"],
      "defaultMotion": "depth",
      "threeJs": "default",
      "layoutHints": ["blurred gradient blobs in background", "cards float over background", "thin 1px white/alpha borders"]
    },
    {
      "id": "retro",
      "name": "Retro",
      "tagline": "Borrowed from a decade.",
      "members": ["Retro Vintage", "American Kitsch", "Y2K Evolution", "Art Deco", "Victorian", "Art Nouveau"],
      "tokens": {
        "radius": "0.25rem",
        "borderWidth": "2px",
        "shadow": "none",
        "texture": "paper",
        "gradients": true,
        "imageTreatment": "sepia",
        "density": "high",
        "titleCase": "title",
        "maxWordsPerSlide": 40
      },
      "defaultPalette": "retro-sorbet",
      "allowedPalettes": ["retro-sorbet", "desert-trail", "royal-court", "deco-gold"],
      "defaultType": "editorial-serif",
      "allowedTypes": ["editorial-serif", "deco-geometric", "retro-script"],
      "defaultMotion": "calm",
      "threeJs": "never",
      "layoutHints": ["ornamental frames on title/summary", "centred compositions", "decorative dividers"]
    },
    {
      "id": "neon",
      "name": "Neon",
      "tagline": "Dark mode, glowing edges.",
      "members": ["Cyberpunk", "Psychedelic", "Liquid Typography"],
      "tokens": {
        "radius": "0.25rem",
        "borderWidth": "1px",
        "shadow": "0 0 18px var(--df-accent)",
        "texture": "scanlines",
        "gradients": true,
        "imageTreatment": "neon-duotone",
        "density": "medium",
        "titleCase": "upper",
        "maxWordsPerSlide": 35
      },
      "defaultPalette": "tokyo-grid",
      "allowedPalettes": ["tokyo-grid", "synthwave-sunset", "midnight-gala"],
      "defaultType": "cyber-display",
      "allowedTypes": ["cyber-display", "brutalist-mono"],
      "defaultMotion": "glitch",
      "threeJs": "optional",
      "layoutHints": ["glow on accent text only, never body", "HUD-style corner brackets", "dark base always"]
    },
    {
      "id": "maximal-pop",
      "name": "Maximal / Pop",
      "tagline": "More colour, more shapes, more energy.",
      "members": ["New Maximalism", "Memphis Design", "Pop Futurism", "Corporate Memphis (Alegria)"],
      "tokens": {
        "radius": "2rem",
        "borderWidth": "2px",
        "shadow": "4px 4px 0 var(--df-accent)",
        "texture": "confetti",
        "gradients": true,
        "imageTreatment": "saturated",
        "density": "high",
        "titleCase": "title",
        "maxWordsPerSlide": 35
      },
      "defaultPalette": "memphis-pastel",
      "allowedPalettes": ["memphis-pastel", "retro-sorbet", "brutal-pop"],
      "defaultType": "pop-rounded",
      "allowedTypes": ["pop-rounded", "geometric-modern"],
      "defaultMotion": "pop",
      "threeJs": "optional",
      "layoutHints": ["scattered geometric decorations (squiggles, dots, triangles)", "overlapping shapes behind titles", "max 3 decorations per slide"]
    },
    {
      "id": "atmospheric",
      "name": "Atmospheric",
      "tagline": "Quiet, cinematic, slightly uncanny.",
      "members": ["Modern Surrealism", "Liminal Space Art"],
      "tokens": {
        "radius": "0",
        "borderWidth": "0",
        "shadow": "none",
        "texture": "fog",
        "gradients": true,
        "imageTreatment": "desaturated",
        "density": "low",
        "titleCase": "sentence",
        "maxWordsPerSlide": 25
      },
      "defaultPalette": "midnight-gala",
      "allowedPalettes": ["midnight-gala", "pacific-forest", "technical-slate"],
      "defaultType": "editorial-serif",
      "allowedTypes": ["editorial-serif", "humanist"],
      "defaultMotion": "depth",
      "threeJs": "optional",
      "layoutHints": ["full-bleed imagery with text in one corner", "wide letter-spacing", "very few words"]
    }
  ]
}
