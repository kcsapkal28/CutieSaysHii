<div class="df-slide flex h-full w-full flex-col gap-[var(--df-gap)] p-[var(--df-pad)] text-df-text font-body">
<h2 data-region="title" data-motion-el class="m-0 empty:hidden font-display text-df-text [text-transform:var(--df-title-transform)] leading-[var(--df-display-lh)] tracking-[calc(var(--df-display-tracking)+var(--df-title-tracking))] [overflow-wrap:anywhere] text-[length:calc(2.5rem*var(--df-scale))]">{{{regions.title}}}</h2>
<div data-region="body" class="min-h-0 flex-1 text-[length:calc(1.75rem*var(--df-scale))] leading-[var(--df-body-lh)] [overflow-wrap:anywhere] min-w-0 [&_.df-quiz-question]:m-0 [&_.df-quiz-question]:font-display [&_.df-quiz-options]:my-[var(--df-gap)] [&_.df-quiz-options]:flex [&_.df-quiz-options]:list-[upper-alpha] [&_.df-quiz-options]:flex-col [&_.df-quiz-options]:gap-3 [&_.df-quiz-options]:pl-[1.5em] [&_.df-quiz-explanation]:hidden">{{{regions.body}}}</div>
</div>
