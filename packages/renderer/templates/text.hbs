<div class="df-slide flex h-full w-full flex-col gap-[var(--df-gap)] p-[var(--df-pad)] text-df-text font-body justify-center">
<h2 data-region="title" data-motion-el class="m-0 empty:hidden font-display text-df-text [text-transform:var(--df-title-transform)] leading-[var(--df-display-lh)] tracking-[calc(var(--df-display-tracking)+var(--df-title-tracking))] [overflow-wrap:anywhere] text-[length:calc(2.25rem*var(--df-scale))] text-df-primary-text">{{{regions.title}}}</h2>
<div data-region="body" class="min-h-0 text-[length:calc(2.25rem*var(--df-scale))] leading-[var(--df-body-lh)] [overflow-wrap:anywhere] min-w-0 [&_p]:m-0">{{{regions.body}}}</div>
</div>
