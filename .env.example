# DeckForge harness configuration (BUILD_PROMPT §1a). Copy to .env (gitignored) and set LLM_API_KEY.
# Never commit a real key.

# The local claude-openai proxy's Anthropic passthrough. Use https://api.anthropic.com to bypass it (CI).
LLM_BASE_URL=http://localhost:4001
# The proxy's shared key (its API_KEY env var or DEFAULT_API_KEY in server.js), or an Anthropic API key.
LLM_API_KEY=<proxy-shared-key>

# Full Claude model ids only (/^claude-[a-z0-9-]+$/); the proxy does not remap names.
LLM_MODEL_CONTENT=claude-sonnet-5-5
LLM_MODEL_DESIGN=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# Let the server fall back to another model on a refusal (beta server-side-fallback-2026-07-01).
LLM_REFUSAL_FALLBACK=1
# Default: on unless LLM_BASE_URL is https://api.anthropic.com. When on, every request sends
# x-proxy-max-retries: 0 and preflight requires the proxy's x-proxy-controls: 1 marker.
# LLM_PROXY_CONTROLS=1

DECKFORGE_JOBS_DIR=jobs
# Default: <DECKFORGE_JOBS_DIR>/deckforge.sqlite
# DECKFORGE_DB_PATH=jobs/deckforge.sqlite
# Token cap per job invocation (input + output + cache read + cache write).
DECKFORGE_TOKEN_BUDGET=250000
