<div class="df-slide flex h-full w-full flex-col gap-[var(--df-gap)] p-[var(--df-pad)] text-df-text font-body">
<h2 data-region="title" data-motion-el class="m-0 empty:hidden font-display text-df-text [text-transform:var(--df-title-transform)] leading-[var(--df-display-lh)] tracking-[calc(var(--df-display-tracking)+var(--df-title-tracking))] [overflow-wrap:anywhere] text-[length:calc(2.5rem*var(--df-scale))]">{{{regions.title}}}</h2>
<div data-region="body" class="flex min-h-0 flex-1 flex-wrap items-center justify-around gap-[var(--df-gap)] [overflow-wrap:anywhere] min-w-0 [&_.df-stat]:flex [&_.df-stat]:min-w-0 [&_.df-stat]:flex-col [&_.df-stat]:items-center [&_.df-stat]:gap-2 [&_.df-stat]:text-center [&_.df-stat-value]:font-display [&_.df-stat-value]:text-df-primary-text [&_.df-stat-value]:leading-none [&_.df-stat-value]:text-[length:calc(6.5rem*var(--df-scale))] [&_.df-stat-label]:text-df-text-muted [&_.df-stat-label]:text-[length:calc(1.5rem*var(--df-scale))]">{{{regions.body}}}</div>
<p data-region="footer" hidden class="m-0">{{{regions.footer}}}</p>
</div>
