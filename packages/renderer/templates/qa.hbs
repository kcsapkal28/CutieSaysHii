<div class="df-slide flex h-full w-full flex-col gap-[var(--df-gap)] p-[var(--df-pad)] text-df-text font-body items-center justify-center text-center">
<h2 data-region="title" data-motion-el class="m-0 empty:hidden font-display text-df-text [text-transform:var(--df-title-transform)] leading-[var(--df-display-lh)] tracking-[calc(var(--df-display-tracking)+var(--df-title-tracking))] [overflow-wrap:anywhere] text-[length:calc(5rem*var(--df-scale))] text-df-primary-text">{{{regions.title}}}</h2>
<p data-region="subtitle" data-motion-el class="m-0 text-[length:calc(1.75rem*var(--df-scale))] text-df-text-muted empty:hidden [overflow-wrap:anywhere] min-w-0">{{{regions.subtitle}}}</p>
</div>
