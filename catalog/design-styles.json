        "radius": "0.5rem",
        "borderWidth": "1px",
        "shadow": "none",
        "texture": "none",
        "gradients": false,
        "imageTreatment": "clean",
        "density": "low",
        "titleCase": "sentence",
        "maxWordsPerSlide": 35
      },
      "defaultPalette": "warm-minimalist",
      "allowedPalettes": ["warm-minimalist", "technical-slate", "nordic-mist", "pacific-forest"],
      "defaultType": "geometric-modern",
      "allowedTypes": ["geometric-modern", "swiss-neutral", "humanist"],
      "defaultMotion": "calm",
      "threeJs": "never",
      "layout": {
        "grid": { "title": [1, 10], "body": [1, 9], "wide": [1, 13], "aside": [10, 13] },
        "align": "start",
