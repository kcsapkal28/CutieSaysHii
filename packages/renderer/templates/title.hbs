<div class="df-slide flex h-full w-full flex-col gap-[var(--df-gap)] p-[var(--df-pad)] text-df-text font-body justify-center">
<p data-region="meta" class="m-0 font-body uppercase tracking-[0.12em] text-df-accent text-[length:calc(1.125rem*var(--df-scale))] empty:hidden [overflow-wrap:anywhere] min-w-0">{{{regions.meta}}}</p>
<h1 data-region="title" data-motion-el class="m-0 font-display text-df-text [text-transform:var(--df-title-transform)] leading-[var(--df-display-lh)] tracking-[calc(var(--df-display-tracking)+var(--df-title-tracking))] [overflow-wrap:anywhere] text-[length:calc(4.5rem*var(--df-scale))]">{{{regions.title}}}</h1>
<p data-region="subtitle" data-motion-el class="m-0 text-[length:calc(1.75rem*var(--df-scale))] text-df-text-muted empty:hidden [overflow-wrap:anywhere] min-w-0">{{{regions.subtitle}}}</p>
</div>
