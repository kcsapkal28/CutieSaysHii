<div class="df-slide flex h-full w-full flex-col gap-[var(--df-gap)] p-[var(--df-pad)] text-df-text font-body">
<h2 data-region="title" data-motion-el class="m-0 empty:hidden font-display text-df-text [text-transform:var(--df-title-transform)] leading-[var(--df-display-lh)] tracking-[calc(var(--df-display-tracking)+var(--df-title-tracking))] [overflow-wrap:anywhere] text-[length:calc(2.5rem*var(--df-scale))]">{{{regions.title}}}</h2>
<div class="flex min-h-0 flex-1 gap-[var(--df-gap)] [overflow-wrap:anywhere] min-w-0">
<div data-region="left" class="min-h-0 min-w-0 flex-1 rounded-[var(--df-radius)] border-[length:var(--df-border-width)] border-df-border bg-df-surface p-[var(--df-gap)] [box-shadow:var(--df-shadow)] [&_.df-compare-title]:m-0 [&_.df-compare-title]:mb-[var(--df-gap)] [&_.df-compare-title]:font-display [&_.df-compare-title]:text-df-primary-text [&_.df-compare-title]:text-[length:calc(1.75rem*var(--df-scale))] [&_ul]:m-0 [&_ul]:flex [&_ul]:list-none [&_ul]:flex-col [&_ul]:gap-[calc(var(--df-gap)*0.6)] [&_ul]:p-0 [&_li]:text-[length:calc(1.5rem*var(--df-scale))] [overflow-wrap:anywhere] min-w-0">{{{regions.left}}}</div>
<div data-region="right" class="min-h-0 min-w-0 flex-1 rounded-[var(--df-radius)] border-[length:var(--df-border-width)] border-df-border bg-df-surface p-[var(--df-gap)] [box-shadow:var(--df-shadow)] [&_.df-compare-title]:m-0 [&_.df-compare-title]:mb-[var(--df-gap)] [&_.df-compare-title]:font-display [&_.df-compare-title]:text-df-primary-text [&_.df-compare-title]:text-[length:calc(1.75rem*var(--df-scale))] [&_ul]:m-0 [&_ul]:flex [&_ul]:list-none [&_ul]:flex-col [&_ul]:gap-[calc(var(--df-gap)*0.6)] [&_ul]:p-0 [&_li]:text-[length:calc(1.5rem*var(--df-scale))] [overflow-wrap:anywhere] min-w-0">{{{regions.right}}}</div>
</div>
</div>
